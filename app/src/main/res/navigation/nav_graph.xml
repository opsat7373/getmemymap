<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mapListFragment">

    <fragment
        android:id="@+id/mapListFragment"
        android:name="com.opsat.getmemymap.ui.map.MapListFragment"
        android:label="map_item_list"
        tools:layout="@layout/map_item_list" >
        <argument
            android:name="parentMapName"
            app:argType="string"
            app:nullable="false"
            android:defaultValue="europe"/>
        <argument
            android:name="showMemoryInfo"
            app:argType="boolean"
            android:defaultValue="true"/>
        <action
            android:id="@+id/action_mapFragment_self"
            app:destination="@id/mapListFragment">
            <argument
                android:name="parentMapName"
                app:nullable="false"
                android:defaultValue=""/>
            <argument
                android:name="showMemoryInfo"
                android:defaultValue="false"/>
        </action>
    </fragment>
</navigation>